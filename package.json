{
  "name": "albion-farm-economy-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "audit:test": "node skills/security-audit/validate-findings.test.cjs && node skills/security-audit/validate-coverage-ledger.test.cjs",
    "audit:validate-findings": "node skills/security-audit/validate-findings.cjs",
    "audit:validate-coverage": "node skills/security-audit/validate-coverage-ledger.cjs",
    "sdd:validate": "node skills/spec-driven-development/scripts/validate-specs.cjs",
    "devtools:audit": "node scripts/chrome-devtools-audit.cjs",
    "test:domain": "node --test test/domain-economy.test.cjs",
    "test:e2e": "e2e run",
    "subagents:run": "node scripts/run-subagents.cjs",
    "qa:audit": "node scripts/qa-audit.cjs",
    "agent:verify": "npm run sdd:validate && npm run audit:test && npm run lint && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.13.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "e2e": "^0.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^2.0.0"
  }
}
